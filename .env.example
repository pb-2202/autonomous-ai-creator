# ==============================================================================
# Autonomous AI Creator Environment Configuration Audit
# Copy this file to .env.local for local development. Never commit .env.local.
# ==============================================================================

# 1. REQUIRED FOR PRODUCTION
# PostgreSQL database connection string (used by API routes, migrations, and background worker).
DATABASE_URL=postgresql://autonomous_creator:autonomous_creator@localhost:5432/autonomous_creator

# 2. OPTIONAL CONFIGURATIONS (With Safe Local Defaults)
# AI Provider selection: 'mock' (safe local default), 'gemini', or 'openai'.
AI_PROVIDER=mock

# Gemini Provider configuration (Required when AI_PROVIDER=gemini)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# OpenAI Provider configuration (Required when AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Memory Subsystem provider: 'mock' (safe local default) or 'breeth'.
MEMORY_PROVIDER=mock
# Breeth memory API key (Optional. Application and worker function reliably without it).
BREETH_API_KEY=

# 3. WORKER SCHEDULING & DISCOVERY TUNING
# Worker job execution interval (in seconds). Default: 300 (5 minutes).
AGENT_RUN_INTERVAL_SECONDS=300
# Background worker database polling tick (in milliseconds). Default: 5000 (5 seconds).
WORKER_POLL_INTERVAL_MS=5000

# Live Discovery configuration (timeout in ms, max items fetched per feed).
DISCOVERY_TIMEOUT_MS=8000
DISCOVERY_MAX_ITEMS_PER_SOURCE=15

# Set WORKER_SINGLE_RUN=true for single-pass worker execution in CLI or tests.
# WORKER_SINGLE_RUN=true
