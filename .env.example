# Copy this file to .env.local for local development. Never commit real values.
# Used by API routes, migrations, and the future worker.
DATABASE_URL=postgresql://autonomous_creator:autonomous_creator@localhost:5432/autonomous_creator

# Reserved for the autonomous-agent implementation.
OPENAI_API_KEY=
BREETH_API_KEY=

# Worker scheduling and polling configuration (in seconds / milliseconds).
# For local development, lower values (e.g. 30–60s) can be used.
AGENT_RUN_INTERVAL_SECONDS=300
WORKER_POLL_INTERVAL_MS=5000

